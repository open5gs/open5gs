--
-- Edge Enabling Infrastructure Resource Usage Charging Information
--

EdgeInfrastructureUsageChargingInformation	::= SET
{
	meanVirtualCPUUsage				[0] REAL OPTIONAL,
	meanVirtualMemoryUsage			[1] REAL OPTIONAL,
	meanVirtualDiskUsage			[2] REAL OPTIONAL,
	durationStartTime				[3] TimeStamp OPTIONAL,
	durationEndTime					[4] TimeStamp OPTIONAL,
	measuredInBytes					[5]	INTEGER OPTIONAL,
	measuredOutBytes				[6]	INTEGER OPTIONAL
}

--
-- EAS Deployment Charging Information
--

EASDeploymentChargingInformation	::= SET
{
