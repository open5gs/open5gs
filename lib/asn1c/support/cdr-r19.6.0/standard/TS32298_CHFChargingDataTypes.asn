	mscAddress								[11] MSCAddress OPTIONAL,
	userSessionID							[12] Session-Id OPTIONAL,
	outgoingSessionID						[13] Session-Id OPTIONAL,
	sessionPriority							[14] SessionPriority OPTIONAL,
