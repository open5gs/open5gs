}

NSACFTrigger			::= INTEGER
{
--Initial
	nSACThresholdInitial						(1),
--Change of charging conditions
	nSACThresholdUpwardsReached					(2),
	nSACThresholdUpwardsCrossed					(3),
	nSACThresholdDownwardsCrossed				(4),
--Quota management
	nSACQuotaThreshold							(5),
	nSACQuotaExhausted							(6),
	nSACValidityTime							(7),
	nSACQHT										(8),
	nSACThresholdTermination					(9),
--Termination
	nSTermination								(10)
}

