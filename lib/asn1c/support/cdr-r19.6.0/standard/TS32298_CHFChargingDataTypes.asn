--Termination
	sIP2xxAcknowledgingASipBye					(16),
	abortingASipSessionSetup					(17),
	sIP3xxFinalOrRedirectionResponse			(18),
	sIP4xx5xxOr6xxFinalResponse					(19),
	sIPByeMessage								(20)
}


